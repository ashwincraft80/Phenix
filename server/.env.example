# SymbioLink Environment Configuration
# Default port 5001 avoids macOS AirPlay Receiver port 5000 collision.
# You can set PORT=5000 if AirPlay Receiver is disabled in macOS System Settings.
PORT=5001

# MongoDB Atlas or Local MongoDB Connection String
# (If not provided or unconnectable, server automatically falls back to built-in in-memory store)
MONGODB_URI=mongodb://127.0.0.1:27017/symbiolink

NODE_ENV=development
